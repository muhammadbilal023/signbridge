ENV=dev                       # use "prod" in production (refuses the default SECRET_KEY)
DATABASE_URL=sqlite:///./signbridge.db
# PostgreSQL example: postgresql+psycopg://signbridge:signbridge@localhost:5432/signbridge
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_MINUTES=1440
CORS_ORIGINS=*                # comma separated, e.g. https://yourapp.com,http://localhost:5000

# Sentence builder (any OpenAI-compatible chat API: Grok/xAI, Qwen/DashScope compatible mode, Groq, ...)
LLM_BASE_URL=                 # e.g. https://api.x.ai/v1  (take it from your provider's docs)
LLM_API_KEY=
LLM_MODEL=                    # model name from your provider's docs

# Firebase login (Google + email with verification link). Project ID is in Firebase console > Project settings.
FIREBASE_PROJECT_ID=
ALLOW_LOCAL_AUTH=false        # true = also keep the plain email/password endpoints

# Optional AI features (also need: pip install -r requirements-ml.txt)
ENABLE_STT=false
WHISPER_MODEL=small
ENABLE_TTS=false

# Sign recognition tuning
SIGN_THRESHOLD=0.7
WORD_GAP_SECONDS=0.5
SENTENCE_GAP_SECONDS=1.5
MIN_WORD_FRAMES=6

# First admin (can upload sign clips / add vocabulary)
ADMIN_EMAIL=
ADMIN_PASSWORD=
